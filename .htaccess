<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block sensitive files and directories directly from web access
    RewriteRule ^(\.env|\.git|storage/.*|bootstrap/cache/.*|composer\.(json|lock)|package\.(json|lock)) - [F,L,NC]

    # Redirect root requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
